# Je Stripe-sleutel. Aanmaken op https://dashboard.stripe.com/apikeys
#
# Begin met de TESTSLEUTEL (sk_test_...): dan werkt alles precies hetzelfde,
# maar wordt er geen echt geld overgemaakt. Testen kan met kaartnummer
# 4242 4242 4242 4242, een datum in de toekomst en willekeurige cijfers.
#
# Pas als alles werkt zet je de live sleutel (sk_live_...) erin. Daarvoor
# moet je bedrijf wel eerst goedgekeurd zijn door Stripe.
STRIPE_SECRET_KEY=sk_test_...

# Het adres waarop deze terminal bereikbaar is. De klant komt hier terug
# nadat hij betaald heeft, dus dit moet het echte adres zijn.
BASE_URL=http://localhost:4000

# Optioneel: laat Stripe zelf melden dat er betaald is. Aanmaken onder
# Developers > Webhooks, met het adres BASE_URL/api/webhook.
STRIPE_WEBHOOK_SECRET=

PORT=4000
