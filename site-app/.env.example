# Poort waarop de server luistert.
PORT=4100

# Het hoofddomein van je platform. Elke site krijgt <naam>.<BASE_DOMAIN>.
# Leeg laten om lokaal uit te proberen: sites staan dan op /s/<naam>/.
BASE_DOMAIN=

# Waar accounts en websites bewaard worden. Moet een herstart overleven.
DATA_DIR=data

# Waar klanten hun domein naartoe moeten laten wijzen (standaard BASE_DOMAIN).
DNS_TARGET=

# Maximale grootte van één website, in MB.
MAX_SITE_MB=200

# Verbindingsregel van een Postgres-database (bijvoorbeeld Neon). Nodig op
# hosting die de schijf wist bij een herstart, zoals gratis Render.
DATABASE_URL=
