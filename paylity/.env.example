# ---------------------------------------------------------------------------
# Paylity — omgevingsvariabelen
#
# Kopieer dit bestand naar .env en vul het in. Zet .env nooit in git; hij staat
# daarom in .gitignore.
# ---------------------------------------------------------------------------

# Verbinding met PostgreSQL. Bij Supabase vind je deze onder
# Project Settings > Database > Connection string (kies "URI").
DATABASE_URL="postgresql://gebruiker:wachtwoord@localhost:5432/paylity?schema=public"

# Draaimodus. Paylity v1 kent alleen "test": er wordt geen echt geld verwerkt.
PAYLITY_MODE="test"

# Welke betaalprovider actief is. "simulated" is de gesimuleerde provider die
# geen geld verwerkt. Koppel je later een erkende provider, dan zet je hier
# diens naam neer (zie src/lib/providers/index.ts).
PAYMENT_PROVIDER="simulated"

# Geheim waarmee uitgaande webhooks worden ondertekend. Maak er een eigen van:
#   node -e "console.log('whsec_' + require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SIGNING_SECRET="whsec_vervang_dit_door_een_eigen_geheim"

# Het adres waarop de app bereikbaar is. Wordt gebruikt in de betaallinks die
# de API teruggeeft.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Hoe lang een abonnementscontrole hergebruikt wordt, in milliseconden.
# Optioneel; standaard 60000.
# ABO_CACHE_MS="60000"
