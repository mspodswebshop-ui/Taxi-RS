# ---------------------------------------------------------------------------
# Weblity — omgevingsvariabelen
#
# Kopieer dit bestand naar .env en vul het in. Zet .env nooit in git; hij staat
# daarom in .gitignore.
# ---------------------------------------------------------------------------

# Verbinding met PostgreSQL (lokaal, Neon, Supabase, Render, ...).
DATABASE_URL="postgresql://gebruiker:wachtwoord@localhost:5432/weblity?schema=public"

# Eerste beheerder, aangemaakt door `npm run db:seed` of `npm run admin:create`.
# Laat je ADMIN_PASSWORD leeg, dan wordt er een willekeurig wachtwoord gemaakt
# en één keer getoond.
ADMIN_EMAIL="jij@weblity.be"
ADMIN_PASSWORD=""

# Optioneel: eigen domeinnamen van klanten.
# Zet hier de adressen waarop Weblity zelf draait, gescheiden door komma's.
# Elk ander adres dat binnenkomt, wordt opgezocht als domein van een klant
# (veld "Domein" bij de site). Leeg = uitgeschakeld.
# PLATFORM_HOSTS="weblity.be,www.weblity.be,localhost:3000"
