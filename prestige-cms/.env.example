# Wachtwoord om in te loggen op /admin. Laat leeg om het ingebouwde
# wachtwoord te gebruiken; vul in om een ander wachtwoord te kiezen.
ADMIN_PASSWORD=

# Willekeurige lange tekst om de login te beveiligen. Laat leeg om er bij elke
# start een nieuwe te maken (dan moet je na een herstart opnieuw inloggen).
SESSION_SECRET=

# Postgres-database (bv. gratis bij neon.tech). Laat leeg om alles in de map
# data/ op te slaan; dat werkt alleen op een server met een vaste schijf.
DATABASE_URL=

# Poort van de server.
PORT=5000
