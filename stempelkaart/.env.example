# ===================== Algemeen =====================

# Het adres waarop de app bereikbaar is. Moet https zijn, anders werken de
# kaarten in Apple Wallet zichzelf niet bij en weigert Google het logo.
BASE_URL=http://localhost:4100
PORT=4100

BEDRIJF=Taxi R.S.
BEDRIJF_TELEFOON=+32 484 90 81 95
STEMPELS_NODIG=10
BELONING=Gratis rit
# Optioneel, komt op de achterkant van de kaart.
VOORWAARDEN=Gratis rit tot max. € 25 binnen de regio Antwerpen. Niet inwisselbaar voor geld.

# Pincode waarmee chauffeurs inloggen om stempels te zetten.
CHAUFFEUR_PIN=
# Lange willekeurige tekst. Maak er een met:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSIE_GEHEIM=

# Waar de kaarten bewaard worden. Bij Render: het pad van je Disk.
DATA_DIR=./data

# ===================== Apple Wallet =====================
# Zie README, stap 3. Elk certificaat mag de inhoud zelf zijn, een pad naar
# een bestand, of de inhoud in base64.
APPLE_PASS_TYPE_ID=pass.be.taxirs.stempelkaart
APPLE_TEAM_ID=
APPLE_WWDR_CERT=./certs/wwdr.pem
APPLE_SIGNER_CERT=./certs/signerCert.pem
APPLE_SIGNER_KEY=./certs/signerKey.pem
APPLE_SIGNER_KEY_PASSPHRASE=

# ===================== Google Wallet =====================
# Zie README, stap 4.
GOOGLE_ISSUER_ID=
# Het JSON-sleutelbestand van je serviceaccount: pad, inhoud of base64.
GOOGLE_SERVICE_ACCOUNT=./certs/serviceaccount.json
