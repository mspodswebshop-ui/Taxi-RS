# Verplicht: de PostgreSQL-database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toonbank?schema=public"

# Het publieke adres van het platform, zonder slash op het eind.
# Stripe stuurt klanten hierheen terug na het betalen.
BASE_URL="http://localhost:3100"

# ---------------------------------------------------------------------------
# Stripe (optioneel). Zonder deze sleutels draait alles in TESTMODUS: klanten
# kunnen bestellen en "betalen" met een testknop, er gaat geen geld rond.
# ---------------------------------------------------------------------------

# Je platformsleutel. Begint met sk_test_ (testen) of sk_live_ (echt geld).
# Winkels koppelen hun eigen Stripe-rekening via Stripe Connect; het geld van
# een verkoop gaat rechtstreeks naar de winkel, min de platformkosten voor jou.
STRIPE_SECRET_KEY=""

# Uit Stripe > Developers > Webhooks. Webhook-adres: <BASE_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# Prijs-ID (price_...) van het maandabonnement "Pro" voor winkeliers.
STRIPE_PRO_PRICE_ID=""

# Platformkosten per verkoop, in procenten. Hiermee verdien jij aan elke
# verkoop in elke winkel. Pro-winkels betalen het lagere percentage.
PLATFORM_FEE_PERCENT_FREE="2"
PLATFORM_FEE_PERCENT_PRO="0.5"
