// Toonbank - databaseschema
//
// Eén platform, veel winkels. Elke tabel met winkelgegevens heeft een storeId,
// en elke query in het beheerscherm filtert daarop. Zo ziet een winkelier
// nooit de producten, klanten of bestellingen van een andere winkel.
//
// Bedragen staan overal in centen als geheel getal.
// Kaartgegevens staan hier nooit: die vult de klant in bij Stripe zelf.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ---------------------------------------------------------------- */
/* Winkeliers                                                       */
/* ---------------------------------------------------------------- */

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  stores   Store[]
  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/* ---------------------------------------------------------------- */
/* Winkel                                                           */
/* ---------------------------------------------------------------- */

model Store {
  id          String  @id @default(cuid())
  // Het adres van de winkel: /s/<slug>
  slug        String  @unique
  name        String
  tagline     String  @default("")
  description String  @default("")
  email       String
  currency    String  @default("EUR")
  // Uiterlijk van de winkel
  accentColor String  @default("#111827") @map("accent_color")
  logoImageId String? @map("logo_image_id")
  heroTitle   String  @default("") @map("hero_title")
  heroText    String  @default("") @map("hero_text")
  heroImageId String? @map("hero_image_id")
  // Verzending
  shippingCents      Int  @default(495) @map("shipping_cents")
  freeShippingCents  Int? @map("free_shipping_cents")
  // BTW-percentage dat in de prijzen inbegrepen zit (alleen voor de factuur).
  taxPercent  Int     @default(21) @map("tax_percent")
  // Winkel offline zetten zonder iets te verwijderen.
  published   Boolean @default(true)

  // Abonnement bij het platform: "free" of "pro".
  plan                 String  @default("free")
  stripeCustomerId     String? @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")

  // Stripe Connect: de rekening van de winkelier waar het geld naartoe gaat.
  stripeAccountId      String? @unique @map("stripe_account_id")
  stripeChargesEnabled Boolean @default(false) @map("stripe_charges_enabled")

  // Teller voor bestelnummers per winkel (#1001, #1002, ...).
  nextOrderNumber Int @default(1001) @map("next_order_number")

  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products    Product[]
  collections Collection[]
  customers   Customer[]
  orders      Order[]
  discounts   DiscountCode[]
  images      Image[]

  @@index([ownerId])
  @@map("stores")
}

/* ---------------------------------------------------------------- */
/* Catalogus                                                        */
/* ---------------------------------------------------------------- */

model Product {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  title       String
  // Deel van de URL: /s/<winkel>/products/<handle>
  handle      String
  description String   @default("")
  // "active" staat in de winkel, "draft" niet.
  status      String   @default("active")
  // Naam van de optie, bv. "Maat" of "Kleur". Leeg = geen varianten.
  optionName  String   @default("") @map("option_name")
  vendor      String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants    Variant[]
  images      ProductImage[]
  collections Collection[]

  @@unique([storeId, handle])
  @@index([storeId, status])
  @@map("products")
}

// Elk product heeft minstens één variant. Een product zonder opties heeft één
// variant met de titel "Standaard". Prijs en voorraad horen bij de variant.
model Variant {
  id             String  @id @default(cuid())
  productId      String  @map("product_id")
  title          String  @default("Standaard")
  priceCents     Int     @map("price_cents")
  // Doorgestreepte "van"-prijs. Leeg = geen korting tonen.
  compareAtCents Int?    @map("compare_at_cents")
  sku            String  @default("")
  // null = onbeperkte voorraad (bv. digitale producten of op bestelling).
  inventory      Int?
  position       Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("variants")
}

model ProductImage {
  id        String @id @default(cuid())
  productId String @map("product_id")
  imageId   String @map("image_id")
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  image   Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// Afbeeldingen staan in de database zelf. Geen aparte opslagdienst nodig, en
// het werkt overal waar de database werkt. Maximaal een paar MB per foto.
model Image {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  contentType String   @map("content_type")
  data        Bytes
  size        Int
  createdAt   DateTime @default(now()) @map("created_at")

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products ProductImage[]

  @@index([storeId])
  @@map("images")
}

model Collection {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  title       String
  handle      String
  description String   @default("")
  // Op de voorpagina tonen?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, handle])
  @@map("collections")
}

/* ---------------------------------------------------------------- */
/* Klanten, bestellingen en kortingen                               */
/* ---------------------------------------------------------------- */

model Customer {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  email     String
  name      String
  phone     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, email])
  @@map("customers")
}

model Order {
  id         String  @id @default(cuid())
  storeId    String  @map("store_id")
  number     Int
  customerId String? @map("customer_id")

  email      String
  name       String
  phone      String @default("")
  address    String
  postalCode String @map("postal_code")
  city       String
  country    String @default("BE")
  note       String @default("")

  subtotalCents Int     @map("subtotal_cents")
  discountCents Int     @default(0) @map("discount_cents")
  shippingCents Int     @map("shipping_cents")
  totalCents    Int     @map("total_cents")
  // Wat het platform aan deze verkoop verdient.
  platformFeeCents Int  @default(0) @map("platform_fee_cents")
  discountCode  String? @map("discount_code")
  currency      String  @default("EUR")

  // pending -> paid -> (refunded) ; of pending -> cancelled
  status            String    @default("pending")
  // unfulfilled -> fulfilled
  fulfillment       String    @default("unfulfilled")
  trackingCode      String    @default("") @map("tracking_code")
  // "test" of "stripe"
  paymentProvider   String    @map("payment_provider")
  stripeSessionId   String?   @unique @map("stripe_session_id")
  stripePaymentIntent String? @map("stripe_payment_intent")
  paidAt            DateTime? @map("paid_at")
  // Voorraad wordt pas afgeboekt bij betaling; deze vlag voorkomt dubbel afboeken.
  stockApplied      Boolean   @default(false) @map("stock_applied")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@unique([storeId, number])
  @@index([storeId, createdAt])
  @@index([storeId, status])
  @@map("orders")
}

// Een momentopname: titel en prijs worden gekopieerd, zodat een bestelling
// klopt ook als het product later wordt aangepast of verwijderd.
model OrderItem {
  id           String  @id @default(cuid())
  orderId      String  @map("order_id")
  variantId    String? @map("variant_id")
  productTitle String  @map("product_title")
  variantTitle String  @map("variant_title")
  priceCents   Int     @map("price_cents")
  quantity     Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model DiscountCode {
  id              String    @id @default(cuid())
  storeId         String    @map("store_id")
  // Altijd in hoofdletters opgeslagen.
  code            String
  // "percent" of "fixed"
  type            String
  // Procent (1-100) of bedrag in centen.
  value           Int
  minSubtotalCents Int      @default(0) @map("min_subtotal_cents")
  usageLimit      Int?      @map("usage_limit")
  usedCount       Int       @default(0) @map("used_count")
  active          Boolean   @default(true)
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@map("discount_codes")
}

// Elk Stripe-event één keer verwerken, ook als Stripe het opnieuw stuurt.
model ProcessedEvent {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("processed_events")
}
