# Je Claude API-sleutel. Haal er een op via https://console.anthropic.com
# LET OP: zet je echte sleutel in .env (die staat in .gitignore), nooit hier.
ANTHROPIC_API_KEY=sk-ant-...

# Poort waarop de app draait (optioneel)
PORT=3000

# ---------------------------------------------------------------------------
# Abonnementen (optioneel)
#
# Laat STRIPE_SECRET_KEY leeg en de app is gewoon vrij toegankelijk. Vul hem in
# en bezoekers moeten een abonnement nemen voordat ze kunnen chatten:
# Standaard (8 euro), Medium (15 euro) of Pro (22 euro) per maand. Wat elk
# abonnement biedt, staat in lib/plannen.js.
#
# 1. Maak een account op https://stripe.com
# 2. Haal je geheime sleutel op bij https://dashboard.stripe.com/apikeys
#    Begin met de testsleutel (sk_test_...): dan wordt er geen echt geld
#    overgemaakt en kun je testen met kaart 4242 4242 4242 4242.
# 3. De prijzen maakt de server zelf aan in Stripe. Je hoeft niets in te stellen.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=

# Aantal gratis proefdagen (0 = geen proefperiode)
STRIPE_PROEFDAGEN=0

# Het adres waarop de app bereikbaar is. Stripe stuurt de klant hierheen terug
# na het betalen, dus dit moet kloppen zodra de app online staat.
BASE_URL=http://localhost:3000

# Optioneel: eigen Stripe-prijzen in plaats van de automatisch aangemaakte.
# STRIPE_PRICE_STANDAARD=price_...
# STRIPE_PRICE_MEDIUM=price_...
# STRIPE_PRICE_PRO=price_...

# Optioneel: een eigen geheim om toegangscodes mee te ondertekenen. Standaard
# wordt de Stripe-sleutel gebruikt; vervang je die, dan vervallen alle codes.
# APP_SECRET=
