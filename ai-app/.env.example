# Je Claude API-sleutel. Haal er een op via https://console.anthropic.com
# LET OP: zet je echte sleutel in .env (die staat in .gitignore), nooit hier.
ANTHROPIC_API_KEY=sk-ant-...

# Poort waarop de app draait (optioneel)
PORT=3000

# ---------------------------------------------------------------------------
# Abonnementen (optioneel)
#
# Laat deze leeg en de app is gewoon vrij toegankelijk. Vul ze in en bezoekers
# moeten een abonnement nemen voordat ze kunnen chatten.
#
# 1. Maak een account op https://stripe.com
# 2. Maak onder Producten een product met een terugkerende prijs, bijvoorbeeld
#    9 euro per maand. Kopieer het prijs-id (begint met price_).
# 3. Haal je geheime sleutel op bij https://dashboard.stripe.com/apikeys
#    Begin met de testsleutel (sk_test_...): dan wordt er geen echt geld
#    overgemaakt en kun je testen met kaart 4242 4242 4242 4242.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Aantal gratis proefdagen (0 = geen proefperiode)
STRIPE_PROEFDAGEN=0

# Het adres waarop de app bereikbaar is. Stripe stuurt de klant hierheen terug
# na het betalen, dus dit moet kloppen zodra de app online staat.
BASE_URL=http://localhost:3000
